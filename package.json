{
  "name": "dust-hex",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Dust Hex — a haunted Old West fight on a small board (Vite + React + TS)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "e2e": "node e2e/drag.mjs && node e2e/slide.mjs && node e2e/shop.mjs && node e2e/title.mjs && node e2e/flow.mjs && node e2e/coins.mjs"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.2.6",
    "@fontsource/cinzel-decorative": "^5.2.6",
    "@fontsource/libre-baskerville": "^5.2.6",
    "@fontsource/rye": "^5.3.0",
    "@vercel/blob": "^2.8.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^2.1.9"
  }
}
