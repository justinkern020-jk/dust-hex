{
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "cleanUrls": false,
  "rewrites": [
    { "source": "/((?!assets/|api/|cards/|icons/|favicon\\.svg|manifest\\.webmanifest|og\\.jpg|x-banner\\.jpg).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)\\.(js|css)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
  ]
}
