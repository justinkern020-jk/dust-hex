{
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "rewrites": [
    { "source": "/((?!assets/|api/|build/|cards/|icons/|favicon\\.svg|manifest\\.webmanifest|og\\.jpg|x-banner\\.jpg).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/build/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
  ]
}
